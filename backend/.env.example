APP_NAME="School System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite is fine for local dev; switch to mysql or pgsql for anything shared
# or deployed — see docs/production-readiness.md.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306          # 3306 for mysql, 5432 for pgsql
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_COOKIE=app_session
AUTH_STATUS_COOKIE=auth_status

SANCTUM_STATEFUL_DOMAINS=localhost:3000
FRONTEND_URLS=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OAuth (user) app — see docs/zoom-integration.md for how to create one and
# fill these in. ZOOM_REDIRECT_URI must exactly match the redirect URL
# configured on the Zoom app and point at this backend, not the frontend.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:8000/api/zoom/callback

# AI drafts of announcements, via OpenRouter (key from openrouter.ai/keys).
# Free models are rate limited and the provider may log prompts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Central dashboard (docs/central-dashboard-plan.md). Two-factor for system
# admins is on unless this is false. Turn it off only for local development.
PLATFORM_TWO_FACTOR=true

# Demo data (docs/demo-seeder-plan.md) is seeded automatically when APP_ENV is
# local or testing. Set this to true to seed it in any other environment.
SEED_DEMO=false

# Self-service schools (docs/self-service-schools-plan.md): the plan they start
# on, and how many one account may create.
SCHOOLS_SELF_SERVICE_PLAN=basic
SCHOOLS_MAX_SELF_SERVICE_PER_USER=3
