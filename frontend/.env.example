LARAVEL_API_URL=http://localhost:8000
# Same value as BFF_SHARED_SECRET in the backend's .env: lets the API's
# per-visitor limits see the visitor's address (TrustBffClientIp). Server only.
BFF_SHARED_SECRET=
NEXT_PUBLIC_AUTH_STATUS_COOKIE=auth_status

# Demo/testing deployments only: shows a "Use the demo account" button on each
# login form that fills in the seeded account (docs/demo-accounts.md).
# Build-time: set it before building (e.g. in Vercel), then redeploy.
NEXT_PUBLIC_DEMO_LOGINS=false

# Public demo deployment (backend docs/demo-sandboxes.md): gives each visitor
# their own copy of the demo data. Server only; must match the backend's
# DEMO_MODE. Use with NEXT_PUBLIC_DEMO_LOGINS=true.
DEMO_SANDBOXES=false
